# Konfigurasi Database MySQL
# Local Development (XAMPP/Laragon/MySQL): host=localhost, user=root, password kosong, db=simulator
# Produksi Hostinger: ganti dengan kredensial database MySQL dari hPanel Hostinger
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="simulator"

# Port server aplikasi (default 3000)
PORT="3000"

# Opsional: Base URL API jika frontend di-host terpisah atau memakai PHP API di Hostinger Shared Hosting
# Contoh untuk Shared Hosting Hostinger: VITE_API_BASE_URL="/api"
VITE_API_BASE_URL="/api"

# Kredensial Portal Admin (/admin) — WAJIB diganti di produksi Hostinger
ADMIN_USERNAME="admin@kelasbrevet.com"
ADMIN_PASSWORD="GANTI_PASSWORD_ADMIN_KUAT"

# Kunci Rahasia Integrasi Webhook & SSO dari kelasbrevet.com (header X-API-KEY)
INTEGRATION_API_KEY="GANTI_API_KEY_WEBHOOK_KELASBREVET"

# Secret penandatanganan token sesi Admin & SSO (isi string acak panjang)
APP_AUTH_SECRET="GANTI_SECRET_ACAK_MINIMAL_32_KARAKTER"

